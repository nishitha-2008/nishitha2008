#include <stdio.h>

void main()
{
    FILE *fp;
    char name[300];

    // 1. Writing data into file
    fp = fopen("feedback.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "If your moto is to learn na definatly you can explore a lot if not na it is total waste but they are too stict... so times it feels like that much strict is definatly needed but most of the times it irritates to the core");

    fclose(fp);

    printf("Written successfully\n");


    // 2. Appending data into file
    fp = fopen("feedback.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "\nBut seriously they actually try their level best to teach every concept clearly as much as they can");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("feedback.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);

}
